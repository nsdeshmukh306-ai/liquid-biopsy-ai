// =============================================================================
// nextflow.config — Liquid Biopsy AI Pipeline Configuration
// =============================================================================

manifest {
    name            = 'liquid-biopsy-ai'
    author          = 'Liquid Biopsy AI Project'
    description     = 'cfDNA cancer detection pipeline'
    version         = '1.0.0'
    nextflowVersion = '>=22.0.0'
    mainScript      = 'main.nf'
}

// ── Global parameters ────────────────────────────────────────────────────────
params {
    // Input/Output
    reads           = "${projectDir}/../data/fastq/*_{1,2}.fastq.gz"
    genome          = "${projectDir}/../data/ref/hg38.fa"
    outdir          = "${projectDir}/../results/nextflow"

    // Resource limits
    max_cpus        = 32
    max_memory      = '64.GB'
    max_time        = '240.h'

    // Tool versions (pinned for reproducibility)
    fastqc_version       = '0.11.9'
    trimmomatic_version  = '0.39'
    bwa_version          = '0.7.17'
    samtools_version     = '1.16.1'
    mosdepth_version     = '0.3.3'
    deeptools_version    = '3.5.1'

    // Trimmomatic adapters
    adapters        = 'TruSeq3-PE.fa'
    leading         = 3
    trailing        = 3
    slidingwindow   = '4:15'
    minlen          = 36

    // Feature extraction
    fragment_min    = 100
    fragment_max    = 250
    fragment_bins   = 150
    window_size     = 1000000   // 1 Mb windows for coverage
    cpg_context     = 'CpG'

    // Pipeline control
    skip_qc         = false
    skip_trim       = false
    skip_align      = false
    skip_features   = false
}

// ── Process defaults ─────────────────────────────────────────────────────────
process {
    cpus   = { check_resource(2 * task.attempt) }
    memory = { check_resource(8.GB * task.attempt) }
    time   = { check_resource(4.h * task.attempt) }

    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    withLabel: 'process_low' {
        cpus   = { check_resource(2) }
        memory = { check_resource(4.GB * task.attempt) }
        time   = { check_resource(2.h * task.attempt) }
    }
    withLabel: 'process_medium' {
        cpus   = { check_resource(8) }
        memory = { check_resource(16.GB * task.attempt) }
        time   = { check_resource(8.h * task.attempt) }
    }
    withLabel: 'process_high' {
        cpus   = { check_resource(16) }
        memory = { check_resource(32.GB * task.attempt) }
        time   = { check_resource(16.h * task.attempt) }
    }

    // Conda environments per process
    withName: 'FASTQC' {
        conda = "bioconda::fastqc=${params.fastqc_version}"
    }
    withName: 'TRIMMOMATIC' {
        conda = "bioconda::trimmomatic=${params.trimmomatic_version}"
    }
    withName: 'BWA_MEM' {
        conda = "bioconda::bwa=${params.bwa_version} bioconda::samtools=${params.samtools_version}"
    }
    withName: 'EXTRACT_FEATURES' {
        conda = "bioconda::mosdepth=${params.mosdepth_version} conda-forge::deeptools=${params.deeptools_version} conda-forge::pysam conda-forge::pandas conda-forge::numpy"
    }
}

// ── Executor settings ─────────────────────────────────────────────────────────
executor {
    name      = 'local'
    cpus      = params.max_cpus
    memory    = params.max_memory
}

// ── Resume & caching ──────────────────────────────────────────────────────────
resume = true

// ── Reports ───────────────────────────────────────────────────────────────────
timeline {
    enabled = true
    file    = "${params.outdir}/timeline.html"
    overwrite = true
}
report {
    enabled = true
    file    = "${params.outdir}/report.html"
    overwrite = true
}
dag {
    enabled   = true
    file      = "${params.outdir}/dag.svg"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/trace.txt"
    overwrite = true
    fields    = 'task_id,name,status,exit,realtime,cpus,memory,rss,vmem,peak_rss,peak_vmem'
}

// ── Profiles ──────────────────────────────────────────────────────────────────
profiles {
    standard {
        process.executor = 'local'
    }
    slurm {
        process.executor = 'slurm'
        process.queue    = 'normal'
        conda.enabled    = true
    }
    conda {
        conda.enabled    = true
        conda.useMamba   = false
    }
    docker {
        docker.enabled   = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    test {
        params.reads     = "${projectDir}/../data/test/*_{1,2}.fastq.gz"
        params.max_cpus  = 2
        params.max_memory = '4.GB'
    }
}

// ── Helper function ───────────────────────────────────────────────────────────
def check_resource(obj) {
    try {
        if (obj.getClass() == nextflow.util.MemoryUnit && obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
            return params.max_memory as nextflow.util.MemoryUnit
        else if (obj.getClass() == nextflow.util.Duration && obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
            return params.max_time as nextflow.util.Duration
        else if (obj.getClass() == java.lang.Integer)
            return Math.min(obj, params.max_cpus as int)
        else
            return obj
    } catch (all) {
        println "   ### ERROR ###   Max params are not valid! Please check your config file."
    }
}
